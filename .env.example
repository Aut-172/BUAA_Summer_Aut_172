APP_VERSION=dev

MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=3306
DB_HOST=localhost
DB_PORT=3306

NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_DISCOVERY_FAIL_FAST=false
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_CONFIG_SERVER_ADDR=127.0.0.1:8848
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_CONFIG_NAMESPACE=
NACOS_CONFIG_REFRESH_ENABLED=true

FEIGN_CONNECT_TIMEOUT=1000
FEIGN_READ_TIMEOUT=3000
FEIGN_LOGGER_LEVEL=basic
FEIGN_SENTINEL_ENABLED=true

SENTINEL_ENABLED=true
SENTINEL_EAGER=true
SENTINEL_DASHBOARD=
SENTINEL_RULE_GROUP=DEFAULT_GROUP

REDIS_HOST_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
APP_CACHE_ENABLED=true
APP_CACHE_DEFAULT_TTL=10m
APP_CACHE_TTL_JITTER_RATIO=0.1
APP_CACHE_ENGAGEMENT_REVIEW_LIST_TTL=5m
APP_CACHE_ENGAGEMENT_RATING_TTL=10m
APP_CACHE_ENGAGEMENT_SNAPSHOT_TTL=30m
APP_CACHE_MERCHANT_LIST_TTL=5m
APP_CACHE_MERCHANT_DETAIL_TTL=10m
APP_CACHE_MERCHANT_PRODUCT_DETAIL_TTL=10m
APP_CACHE_MERCHANT_CATEGORIES_TTL=1h
APP_CACHE_MERCHANT_SEARCH_TTL=5m
APP_CACHE_MERCHANT_RECOMMEND_TTL=5m
APP_CACHE_IMAGE_METADATA_TTL=1h
APP_CACHE_IMAGE_BLOB_TTL=10m
APP_CACHE_IMAGE_METADATA_ENABLED=true
APP_CACHE_IMAGE_BLOB_ENABLED=true
APP_CACHE_IMAGE_MAX_BLOB_SIZE_BYTES=524288

GATEWAY_PORT=8080
MERCHANT_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
SETTLEMENT_SERVICE_PORT=8084
FULFILLMENT_SERVICE_PORT=8085
ENGAGEMENT_SERVICE_PORT=8086
FRONTEND_PORT=5173
API_GATEWAY_URL=http://api-gateway:8080
VITE_API_BASE_URL=

JWT_SECRET=LifeAssistant2025SecretKeyForJWTTokenGenerationMustBe256BitsLong
JWT_EXPIRATION=86400000
APP_AUTH_CAPTCHA_ENABLED=true
GATEWAY_CORS_ALLOWED_ORIGINS=*
APP_UPLOAD_MAX_IMAGE_SIZE_BYTES=20971520
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=20MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=120MB

# OSS image storage. Keep disabled for local tests unless credentials are configured.
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-heyuan.aliyuncs.com
OSS_BUCKET=buaa-summer-life-assistant
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=/oss
OSS_UPLOAD_PREFIX=life-assistant
OSS_CNAME_ENABLED=false
VITE_OSS_PUBLIC_BASE_URL=/oss
VITE_OSS_PROXY_TARGET=https://buaa-summer-life-assistant.oss-cn-heyuan.aliyuncs.com
OSS_PROXY_TARGET=https://buaa-summer-life-assistant.oss-cn-heyuan.aliyuncs.com
OSS_PROXY_MAX_IN_FLIGHT=32
PROXY_MAX_IN_FLIGHT=96
PROXY_TIMEOUT_MS=12000
