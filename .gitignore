# Local startup environment overrides
.env
.env.*
!.env.example
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-local.yaml

# Delivery PDFs: keep the final assembled handoff, ignore local scratch exports.
output/*
!output/pdf/
output/pdf/*
!output/pdf/life-service-delivery-pack.pdf

# Keep generated test, performance, and experiment reports versioned.
!reports/
!reports/**
!reports/**/*.log
!reports/**/*.png
!reports/**/*.puml
!reports/**/*.jtl
!reports/**/*.csv
!reports/**/*.json
!reports/**/*.html
!reports/**/*.txt
!reports/**/*.tgz
!reports/**/*.gz
*.jtl

# HPA/JMeter experiments keep archived reports and HTML outputs in git.
# Ignore only transient files produced while re-running local load tests.
reports/perf/**/work/
reports/perf/**/tmp/
reports/perf/**/*.jtl
reports/perf/**/*.log
reports/perf/**/*.tgz
reports/perf/**/*.gz

# Fault tolerance experiments keep concise reports and tabular evidence in git.
# Raw response dumps, service logs, and archives are reproducible and may be noisy.
reports/fault/**/*.json
reports/fault/**/*.log
reports/fault/**/*.tgz
reports/fault/**/*.gz

# Sentinel experiments keep summaries and CSV evidence in git.
# Raw response dumps and archives are reproducible and may be noisy.
reports/sentinel/**/*.json
reports/sentinel/**/*.jsonl
reports/sentinel/**/*.log
reports/sentinel/**/*.tgz
reports/sentinel/**/*.gz
